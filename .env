# Run mode: domain (HTTPS) or localhost (HTTP)
RUN_MODE=localhost

# Release tag for Docker images (e.g. v1.0.1)
PLUMOAI_VERSION=v1.0.1

# Localhost port (only when RUN_MODE=localhost)
LOCALHOST_PORT=3456

# Domain / Traefik — for domain mode
DOMAIN_NAME=localhost
SSL_EMAIL=not-used@localhost

# AWS (optional)
AWS_S3_BUCKET=<YOUR_AWS_S3_BUCKET>
AWS_REGION=<YOUR_AWS_REGION>
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
