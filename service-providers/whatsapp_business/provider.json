{
  "name": "WhatsApp Business",
  "code": "whatsapp_business",
  "auth_type": "oauth2",
  "required_fields": [
    { "key": "client_id", "type": "text", "label": "Client ID" },
    { "key": "client_secret", "type": "password", "label": "Client Secret" },
    { "key": "config_id", "type": "text", "label": "Config ID" }
  ],
  "config": {
    "scope": "whatsapp_business_messaging whatsapp_business_management",
    "authorization_endpoint": "https://graph.facebook.com/oauth/authorize",
    "token_endpoint": "https://graph.facebook.com/oauth/access_token",
    "access_type": "offline",
    "grant_types": ["authorization_code", "refresh_token"]
  },
  "is_active": true
}
